<!-- Outgoing connections are for the image fetcher, which loads a message's
     remote images when the user asks for them; the rest of the app is kept
     off the network by its own request policy. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>com.example.pev</string>
  </array>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
